{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix participant",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{execution/**,public/**}",
      "excludeFiles": "{src/**,participant/**,node_modules/**,tests/**,.tmp/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path=/api/:path*"
    },
    {
      "source": "/sdk.js",
      "destination": "/api/index.py?__path=/sdk.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path=/health"
    },
    {
      "source": "/participant/:path*",
      "destination": "/participant/index.html"
    }
  ]
}
