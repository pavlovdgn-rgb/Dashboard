# Vercel > Project > Settings > Environment Variables (server-only secrets).
# Create a Turso database with the libSQL engine, not the new Turso engine.
TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
TURSO_AUTH_TOKEN=
# A shared workspace password, at least 12 characters. Participants use it too.
UXLAB_ACCESS_PASSWORD=
# Optional: comma-separated exact HTTPS origins for additional trusted interfaces.
UXLAB_ALLOWED_ORIGINS=
